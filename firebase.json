{
  "hosting": {
    "public": "dist/frontend/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "!**/*.@(jpeg|jpg|png|webp|gif|svg|ico|js|css|woff|woff2|json|txt|map|webmanifest)",
        "destination": "/index.html"
      }
    ]
  }
}
